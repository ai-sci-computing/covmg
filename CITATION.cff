cff-version: 1.2.0
title: "covmg: gauge-covariant geometric multigrid for the connection Laplacian"
message: "If you use this software or results produced with it, please cite the accompanying paper."
type: software
authors:
  - family-names: "Knöppel"
    given-names: "Felix"
